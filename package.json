{
  "name": "xautenic-demo",
  "version": "1.1.0",
  "description": "Demo operativa Hotel + Eventos - Xautenic / Carlos",
  "main": "main.js",
  "scripts": {
    "start": "electron . --disable-gpu --no-sandbox",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "package:full": "electron-forge package",
    "make": "electron-forge make --platform=win32 --arch=x64",
    "make:full": "cross-env XAUTENIC_CROSS_PLATFORM=1 electron-forge make",
    "release:check": "node scripts/release-check.js",
    "release:demo": "npm run make && npm run release:check",
    "release:demo:signed": "cross-env XAUTENIC_SIGN=1 electron-forge make --platform=win32 --arch=x64 && npm run release:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
